{
  "name": "@aipw/provider-openai",
  "version": "0.0.0",
  "description": "OpenAI-compatible adapter for aipw (Microsoft Foundry in pipelines, OpenAI, GitHub Models, Ollama).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipw/core": "0.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
