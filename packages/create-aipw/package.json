{
  "name": "create-aipw",
  "version": "0.0.0",
  "description": "npm init aipw: adds aipw (AI-driven Playwright testing) to a project in one command.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "create-aipw": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --sourcemap --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "engines": {
    "node": ">=22.12"
  }
}
