{
  "name": "@aipw/cli",
  "version": "0.0.0",
  "private": true,
  "description": "aipw command line: nudge, doctor, cache, conformance.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --sourcemap --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "bin": {
    "aipw": "./dist/cli.js"
  },
  "dependencies": {
    "@aipw/core": "0.0.0"
  }
}
