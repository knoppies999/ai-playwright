{
  "name": "@aipw/cli",
  "version": "0.0.0",
  "description": "aipw command line: nudge, doctor, cache, conformance.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --sourcemap --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipw/core": "0.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.0"
  },
  "engines": {
    "node": ">=22"
  }
}
