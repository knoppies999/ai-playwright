[
  {
    "name": "click",
    "description": "Click an element.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Element ref from the current snapshot, e.g. \"e12\" or \"f1e3\""
        },
        "button": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "left",
                "right",
                "middle"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Default left"
        },
        "modifiers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Alt",
                  "Control",
                  "Meta",
                  "Shift"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Keys held during the click"
        },
        "clickCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ],
          "description": "2 for a double click"
        },
        "intent": {
          "type": "string",
          "description": "What this action is trying to do, in at most 15 words"
        }
      },
      "required": [
        "ref",
        "button",
        "modifiers",
        "clickCount",
        "intent"
      ],
      "additionalProperties": false
    }
  },
