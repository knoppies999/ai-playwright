{
  "name": "@aipw/core",
  "version": "0.1.0",
  "description": "aipw engine: step runner, agent loop, observer, executor, locators, cache. No provider SDK or test-runner dependency.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --target node22 --loader .md=text",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
