{
  "name": "aipw",
  "version": "0.1.0",
  "description": "AI-driven Playwright testing: English steps that record once and replay without the model.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "source": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "bin": {
    "aipw": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/reporter.ts src/bin.ts --format esm --dts --clean --sourcemap --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@aipw/cli": "0.1.0",
    "@aipw/core": "0.1.0",
    "@aipw/test": "0.1.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
